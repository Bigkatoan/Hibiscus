{
  "name": "hibiscus-email-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that sends Hibiscus transactional email via the send_email binding (HMAC-signed requests from the API)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
