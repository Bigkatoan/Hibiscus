# Hibiscus deployment environment. Copy to deploy/.env (git-ignored), then replace every
# CHANGE_ME. Generate secrets with:  deploy/scripts/gen-secrets.sh >> deploy/.env
# Never commit deploy/.env. Rotation procedures: docs/runbook/secrets.md.
#
# Every variable consumed by docker-compose.yml is listed here; variables marked (required)
# make `docker compose config` fail when missing. Names that reach a container are exactly the
# application setting names (deploy/tests/test_env_contract.py checks both files).

# --- general -------------------------------------------------------------------------------
# prod | dev | test (backend Settings.env). prod refuses to start without the secrets below.
HIBISCUS_ENV=prod
HIBISCUS_VERSION=0.1.1
HIBISCUS_IMAGE_TAG=dev
HIBISCUS_PUBLIC_BASE_URL=https://robot.example.com
HIBISCUS_LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh
# "host" when bridge containers have no outbound DNS/egress on this machine (install.md §2).
HIBISCUS_BUILD_NETWORK=default

# --- Postgres (required) -------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
HIBISCUS_DB_NAME=hibiscus
HIBISCUS_DB_USER=hibiscus
HIBISCUS_DB_PASSWORD=CHANGE_ME
HIBISCUS_DB_MONITOR_PASSWORD=CHANGE_ME

# --- Redis (required) ----------------------------------------------------------------------
HIBISCUS_REDIS_PASSWORD=CHANGE_ME

# --- MinIO (required) ----------------------------------------------------------------------
MINIO_ROOT_USER=hibiscus-root
MINIO_ROOT_PASSWORD=CHANGE_ME
# The application's MinIO user (created by minio-init); read by the api and every worker.
HIBISCUS_S3_ACCESS_KEY=hibiscus-app
HIBISCUS_S3_SECRET_KEY=CHANGE_ME
HIBISCUS_UPLOADS_EXPIRE_DAYS=14
HIBISCUS_NONCURRENT_EXPIRE_DAYS=30

# --- application secrets (required) --------------------------------------------------------
# 32 random bytes, base64. Encrypts TOTP secrets and user secrets (AES-256-GCM, db-schema.md).
HIBISCUS_DATA_KEY=CHANGE_ME
# Ed25519 private key (PKCS8 PEM) that signs access tokens. One line, newlines written as \n
# inside DOUBLE quotes (compose's env-file parser expands them); gen-secrets.sh prints it so.
HIBISCUS_JWT_PRIVATE_KEY="CHANGE_ME"
# HMAC key for pagination cursors (random, >= 32 bytes).
HIBISCUS_CURSOR_SECRET=CHANGE_ME

# --- email (CONTRACT_NOTES §4.1) -----------------------------------------------------------
# cloudflare = signed POST to the Email Worker (deploy/cloudflare/email-worker); smtp; none.
# --- Training: Hugging Face repos runs may load (comma-separated org/name; empty = none allowed)
HIBISCUS_INIT_FROM_HF_ALLOWLIST=
HIBISCUS_VLM_MODEL_ALLOWLIST=HuggingFaceTB/SmolVLM2-500M-Video-Instruct,google/paligemma-3b-pt-224

HIBISCUS_EMAIL_PROVIDER=cloudflare
HIBISCUS_EMAIL_FROM=Hibiscus <no-reply@robot.example.com>
# cloudflare provider (both required in prod when the provider is cloudflare), e.g.
# https://hibiscus-email.<your-subdomain>.workers.dev/send (or a route on your zone)
HIBISCUS_EMAIL_WORKER_URL=
# Same value as the Worker secret HIBISCUS_EMAIL_HMAC_SECRET (wrangler secret put ...), >= 32 chars.
HIBISCUS_EMAIL_WORKER_SECRET=
# smtp provider only (STARTTLS on 587 by default; SMTP_SSL=true for implicit TLS on 465).
HIBISCUS_SMTP_HOST=localhost
HIBISCUS_SMTP_PORT=587
HIBISCUS_SMTP_USERNAME=
HIBISCUS_SMTP_PASSWORD=
HIBISCUS_SMTP_STARTTLS=true
HIBISCUS_SMTP_SSL=false

# --- Cloudflare edge (docs/runbook/cloudflare.md) ------------------------------------------
HIBISCUS_TURNSTILE_SITE_KEY=
HIBISCUS_TURNSTILE_SECRET_KEY=
# Optional Cloudflare Access in front of /admin* and /api/v1/admin* (off when empty).
HIBISCUS_CF_ACCESS_TEAM_DOMAIN=
HIBISCUS_CF_ACCESS_AUD=

# --- Grafana (required) --------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://127.0.0.1:13000/

# --- workers / resources -------------------------------------------------------------------
# GPU selection: index (PCI bus order, = nvidia-smi index) or GPU UUID (docs/runbook/gpu.md).
HIBISCUS_GPU0_DEVICE=0
HIBISCUS_GPU1_DEVICE=1
HIBISCUS_WORKER_GPU_CPUS=4
HIBISCUS_WORKER_GPU_MEMORY=11g
HIBISCUS_WORKER_SHM_SIZE=8gb
HIBISCUS_WORKER_CPU_CPUS=2
HIBISCUS_WORKER_CPU_MEMORY=6g
# LRU dataset cache shared by the GPU workers, in bytes (150 GiB).
HIBISCUS_DATASET_CACHE_MAX_BYTES=161061273600
HIBISCUS_API_WORKERS=2

# --- backups -------------------------------------------------------------------------------
# Host directory for nightly pg_dump files (put it on a different disk than Docker's data-root).
HIBISCUS_BACKUP_DIR=./backups
HIBISCUS_BACKUP_AT=03:15
HIBISCUS_BACKUP_RETENTION_DAYS=14
# (required) Passphrase that encrypts every pg_dump and the MinIO mirror (gpg, AES-256). Keep a
# copy OUTSIDE this host (password manager): without it no backup can be restored.
HIBISCUS_BACKUP_PASSPHRASE=CHANGE_ME

# --- observability -------------------------------------------------------------------------
HIBISCUS_PROMETHEUS_RETENTION=30d
DOCKER_CONTAINERS_DIR=/var/lib/docker/containers

# --- networks (change only if these subnets collide with something on the host) -----------
HIBISCUS_EDGE_SUBNET=172.31.250.0/24
HIBISCUS_EDGE_GATEWAY=172.31.250.1
HIBISCUS_APP_SUBNET=172.31.251.0/24
HIBISCUS_PROXY_APP_IP=172.31.251.2
HIBISCUS_API_APP_IP=172.31.251.10
