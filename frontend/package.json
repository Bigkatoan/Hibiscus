{
  "name": "hibiscus-frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18100 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/check-csp-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 18101 --strictPort",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview:mock": "vite preview --mode mock --host 127.0.0.1 --port 18102 --strictPort",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable=false -o src/api/generated/schema.d.ts && prettier --write src/api/generated/schema.d.ts",
    "check:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable=false -o /tmp/hibiscus-schema.d.ts && prettier --config .prettierrc.json --write /tmp/hibiscus-schema.d.ts >/dev/null && diff -q /tmp/hibiscus-schema.d.ts src/api/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hash-wasm": "4.13.0",
    "i18next": "24.2.1",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "2.6.0",
    "uplot": "1.6.32",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.10.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.6.2",
    "axe-core": "4.14.0",
    "eslint": "9.18.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "msw": "2.7.0",
    "openapi-msw": "1.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5gmw-xhrv-c9v3",
        "GHSA-85c8-ppgw-ccpr",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
